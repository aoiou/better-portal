{
  "manifest_version": 3,
  "name": "Better Portal for Doshisha",
  "version": "1.4.0",
  "minimum_chrome_version": "150",
  "browser_specific_settings": {
    "gecko": {
      "id": "better-portal@tadashin.me",
      "strict_min_version": "150.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "description": "同志社大学ポータル画面のカスタマイズ（並び替え・非表示）およびログイン・認証の自動化を行う拡張機能。※本拡張機能は非公式であり、同志社大学とは関係ありません。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Better Portal for Doshisha"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "commands": {
    "open-login-page": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "同志社ログイン画面を開く"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://doshisha.ex-tic.com/auth/*",
        "https://doshisha.ex-tic.com/idm/user/*",
        "https://doshisha.ex-tic.com/imgmtx/*"
      ],
      "js": [
        "theme-content.js"
      ],
      "css": [
        "theme-content.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://doshisha.ex-tic.com/auth/*"
      ],
      "js": [
        "auth-content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://doshisha.ex-tic.com/idm/user/portal/*"
      ],
      "js": [
        "portal-page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://doshisha.ex-tic.com/idm/user/*"
      ],
      "js": [
        "portal-content.js"
      ],
      "css": [
        "portal-content.css"
      ],
      "run_at": "document_start"
    }
  ]
}
